{
  "name": "housing-platform",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "pnpm --dir tests/integration exec vitest run",
    "seed:embeddings": "node scripts/seed-embeddings.mjs",
    "db:reset": "supabase db reset && node scripts/post-db-reset.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter @housing-platform/ui storybook",
    "storybook:features": "pnpm --filter @housing-platform/web storybook",
    "build-storybook": "pnpm --filter @housing-platform/ui build-storybook",
    "build-storybook:features": "pnpm --filter @housing-platform/web build-storybook"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
