# Frontend (public)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key
VITE_APP_URL=http://localhost:5173

# Backend selection. Default is the Supabase client (PostgREST, RPC, Edge Functions).
# python | java | node speak the OpenAPI contract at VITE_API_BASE_URL.
# VITE_BACKEND=supabase
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# Optional per-feature overrides (unset features follow VITE_BACKEND):
# VITE_BACKEND_AUTH=supabase
# VITE_BACKEND_PROPERTIES=python
# VITE_BACKEND_BOOKINGS=supabase
# VITE_BACKEND_PAYMENTS=supabase
# VITE_BACKEND_HOSTS=supabase
# VITE_BACKEND_ADMIN=supabase
# VITE_BACKEND_NOTIFICATIONS=supabase
# VITE_BACKEND_PROFILE=supabase
# VITE_BACKEND_SEARCH=supabase

# Toss Payments
# VITE_TOSS_CLIENT_KEY=
# VITE_TOSS_SUCCESS_URL=http://127.0.0.1:5173/payment/success
# VITE_TOSS_FAIL_URL=http://127.0.0.1:5173/payment/fail

# Naver Maps — use the ncpKeyId from NCP Console > Maps > Application > Authentication
# Register web URLs as host only (no port): http://localhost and http://127.0.0.1
# VITE_NAVER_MAP_CLIENT_ID=your-ncp-key-id

# Channel.io
# VITE_CHANNEL_PLUGIN_KEY=
# CHANNEL_PLUGIN_KEY=

# Supabase Edge Functions (server secrets — never expose to frontend)
# SUPABASE_SERVICE_ROLE_KEY=
# TOSS_SECRET_KEY=
# PAYMENT_DEV_MOCK=true
# CHANNEL_SECRET=

# Observability
# Enables error tracking, performance traces, and Core Web Vitals (LCP, INP, CLS, FCP, TTFB).
# VITE_SENTRY_DSN=
# SENTRY_DSN=
