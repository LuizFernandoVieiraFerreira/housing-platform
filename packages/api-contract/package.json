{
  "name": "@housing-platform/api-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canonical OpenAPI 3.1 contract. Frontend Zod schemas are generated from it and are not the source of truth.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "generate": "node scripts/generate-zod.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@housing-platform/config": "workspace:*",
    "eslint": "^9.22.0",
    "json-schema-to-zod": "^2.6.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "yaml": "^2.8.0"
  }
}
