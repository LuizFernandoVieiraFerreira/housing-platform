{
  "name": "@housing-platform/backend-node",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,scripts}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run src/test/contract.test.ts",
    "test:authorization": "vitest run src/test/authorization.test.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:pull": "node scripts/prepare-pull-schema.mjs && prisma db pull && node scripts/postprocess-schema.mjs && prisma generate",
    "prisma:diff": "prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@prisma/client": "^6.8.2",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.0.12",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.24.0",
    "prisma": "^6.8.2",
    "supertest": "^7.2.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.30.1",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.1.1",
    "yaml": "^2.8.0"
  }
}
